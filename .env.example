# The Blueprint generates or wires every required value. Nothing to fill in on deploy.
#
# AUTHENTICATION_API_KEY   generated by Render. Global API key and Manager login.
# DATABASE_CONNECTION_URI  wired from evolution-db.
# SERVER_URL               wired from the service's RENDER_EXTERNAL_URL.
#
# Optional integrations. Add them on the evolution-api service after deploy:
# WEBHOOK_GLOBAL_ENABLED=true
# WEBHOOK_GLOBAL_URL=https://example.com/webhook
# OPENAI_ENABLED=true
# TYPEBOT_ENABLED=true
# CHATWOOT_ENABLED=true
# N8N_ENABLED=true
# S3_ENABLED=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=evolution
# S3_ENDPOINT=s3.amazonaws.com
# S3_REGION=us-east-1
